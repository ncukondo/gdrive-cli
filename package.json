{
  "name": "@ncukondo/gdrive-cli",
  "version": "0.5.0",
  "description": "CLI for Google Drive, Docs, and Sheets with multi-account switching, designed for humans and AI agents",
  "keywords": [
    "google-drive",
    "google-docs",
    "google-sheets",
    "cli",
    "gdrive",
    "drive",
    "sheets",
    "docs",
    "oauth",
    "multi-account"
  ],
  "license": "MIT",
  "author": "ncukondo",
  "homepage": "https://github.com/ncukondo/gdrive-cli#readme",
  "bugs": {
    "url": "https://github.com/ncukondo/gdrive-cli/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "gdrive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncukondo/gdrive-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --packages external",
    "build:bin": "bun build src/index.ts --compile --outfile gdrive",
    "build:release": "bun scripts/build-release.ts",
    "test": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "lint": "oxlint src tests scripts",
    "lint:casts": "bun scripts/lint-casts.ts",
    "format": "oxfmt src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "googleapis": "^173.0.0",
    "smol-toml": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "oxlint": "latest",
    "oxfmt": "latest",
    "husky": "^9.1.7"
  }
}
